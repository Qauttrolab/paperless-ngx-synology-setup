# ============================================================
# Paperless-ngx — Umgebungsvariablen
# Diese Datei als .env kopieren und Werte anpassen:
#   cp .env.example .env
#
# ⚠️  .env niemals in Git einchecken! (ist in .gitignore)
# ⚠️  POSTGRES_PASSWORD und PAPERLESS_DBPASS müssen identisch sein!
# ⚠️  PAPERLESS_SECRET_KEY niemals nach erstem Start ändern!
# ============================================================

# Datenbank Passwort (für PostgreSQL)
POSTGRES_PASSWORD=SICHERES_PASSWORT_HIER

# Paperless DB Passwort (muss identisch mit POSTGRES_PASSWORD sein!)
PAPERLESS_DBPASS=GLEICHES_PASSWORT_WIE_OBEN

# Paperless Secret Key — langen zufälligen Key generieren:
# openssl rand -base64 50
PAPERLESS_SECRET_KEY=LANGEN_ZUFAELLIGEN_KEY_HIER

# Grafana Admin Passwort
GF_SECURITY_ADMIN_PASSWORD=GRAFANA_PASSWORT_HIER
